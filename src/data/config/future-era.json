    {
      "id": "ai_social_contract_2028",
      "year": 2028,
      "month": 1,
      "name": "人工智能社会契约",
      "description": "通用人工智能工具开始广泛改变知识工作与制造流程，生产率、岗位替代和技能差距同时上升。",
      "defaultChoiceId": "human_complement",
      "choices": [
        {
          "id": "rapid_automation",
          "name": "加速自动化",
          "description": "优先释放生产率，但接受更强的就业和分配压力。",
          "effects": ["科研与结构生产率提高", "消费、幸福与社会稳定承压"],
          "stateAdjustments": { "aiDiffusion": 0.14, "careCapacity": 0, "adaptationCapacity": 0, "cleanEnergyTransition": 0 },
          "modifiers": [
            { "target": "technology.researchOutput", "operation": "multiply", "value": 1.06, "durationMonths": 96 },
            { "target": "economy.structuralProductivityGrowth", "operation": "add", "value": 0.003, "durationMonths": 96 },
            { "target": "economy.consumptionPropensity", "operation": "multiply", "value": 0.975, "durationMonths": 72 },
            { "target": "society.stability", "operation": "add", "value": -2.5, "durationMonths": 72 }
          ]
        },
        {
          "id": "human_complement",
          "name": "人机互补与再培训",
          "description": "把部署速度与职业教育、终身学习和劳动者转岗绑定。",
          "effects": ["科研、人力资本和生产率稳步提升", "教育与转型财政成本增加"],
          "stateAdjustments": { "aiDiffusion": 0.09, "careCapacity": 0.03, "adaptationCapacity": 0, "cleanEnergyTransition": 0 },
          "modifiers": [
            { "target": "technology.researchOutput", "operation": "multiply", "value": 1.035, "durationMonths": 96 },
            { "target": "education.humanCapitalFormation", "operation": "multiply", "value": 1.05, "durationMonths": 96 },
            { "target": "fiscal.spending", "operation": "multiply", "value": 1.012, "durationMonths": 72 }
          ]
        },
        {
          "id": "strict_precaution",
          "name": "严格审慎准入",
          "description": "优先控制算法风险和岗位冲击，接受扩散与创新速度放缓。",
          "effects": ["稳定和制度可信度提高", "科研扩散与技术商业化放慢"],
          "stateAdjustments": { "aiDiffusion": -0.03, "careCapacity": 0, "adaptationCapacity": 0, "cleanEnergyTransition": 0 },
          "modifiers": [
            { "target": "society.stability", "operation": "add", "value": 1.8, "durationMonths": 72 },
            { "target": "economy.institutionalEfficiencyTarget", "operation": "add", "value": 0.012, "durationMonths": 72 },
            { "target": "technology.researchOutput", "operation": "multiply", "value": 0.98, "durationMonths": 60 }
          ]
        }
      ]
    },
